# Copy this file to .env and replace every CHANGE_ME value.
# NEVER commit .env.

# Image published by GitHub Actions to GHCR.
SCRIPTER_IMAGE=ghcr.io/CHANGE_ME/scripter:latest
SCRIPTER_PORT=8010

# Required only on the first startup, when the database is empty.
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASS=admin

# SSH targets. Example:
# SSH_HOST_1=192.168.1.20
# SSH_PORT_1=22
# SSH_USER_1=scripter
# SSH_PASS_1=change-me
# SSH_KEY_PATH_1=/run/scripter/keys/id_ed25519
# SSH_USE_SUDO_1=1
# SSH_SUDO_WRAPPER_1=/usr/local/sbin/scripter-run
# SSH_LABEL_1=server-1

# Optional strict host-key file inside the container.
# SSH_KNOWN_HOSTS=/run/scripter/keys/known_hosts

# Optional Socket.IO origin. Leave unset unless a reverse proxy requires it.
# SOCKETIO_ORIGIN=https://scripter.example.local

# WARNING: only set this to 1 if a reverse proxy in front of Scripter is
# guaranteed to strip/overwrite any client-supplied CF-Connecting-IP and
# X-Forwarded-For headers. If enabled without such a proxy, any client can
# spoof these headers to bypass the per-IP login lockout entirely.
# TRUST_PROXY_HEADERS=1

# Optional per-server allowlist (comma-separated usernames). If unset, a
# non-sudo server stays open to every authenticated user (prior behaviour);
# a server with SSH_USE_SUDO_n=1 is admin-only unless explicitly listed here,
# since sudo access is equivalent to root on that target.
# SSH_ALLOWED_USERS_1=alice,bob

# v1.1: instance-wide concurrency cap, in addition to the per-user one.
# MAX_GLOBAL_CONCURRENT_EXECUTIONS=20

# v1.2 hardening (uncomment to override the defaults below).
# Max concurrent "running" executions targeting the same server, across all
# users combined — a per-user/global cap alone still lets several accounts
# pile onto one host at once.
# MAX_CONCURRENT_EXECUTIONS_PER_SERVER=2
# Max bytes read at once when viewing a log (/terminal, /log/<id>); older logs
# beyond this are tailed with a truncation notice rather than fully loaded.
# MAX_LOG_READ_BYTES=5242880
# How many days of login attempts (success and failure) to keep; older rows
# are purged at each startup.
# LOGIN_ATTEMPT_LOG_RETENTION_DAYS=30

# v1.0 hardening limits (uncomment to override the defaults below).
# Max number of "running" executions a single user may have at once
# (existing + newly requested in one /run call). Protects target hosts'
# SSH daemons (MaxSessions/MaxStartups) from being exhausted by one account.
# MAX_CONCURRENT_EXECUTIONS_PER_USER=3
# Max bytes of combined stdout/stderr logged/streamed per execution before it
# is forcibly stopped. Protects disk (data/logs) and the browser client from
# a runaway script.
# MAX_EXECUTION_OUTPUT_BYTES=2097152
