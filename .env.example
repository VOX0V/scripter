# Copy this file to .env and replace every CHANGE_ME value.
# NEVER commit .env.

# Image published by GitHub Actions to GHCR.
SCRIPTER_IMAGE=ghcr.io/CHANGE_ME/scripter:latest
SCRIPTER_PORT=8010

# Required only on the first startup, when the database is empty.
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASS=admin

# SSH targets. Example:
# SSH_HOST_1=192.168.1.20
# SSH_PORT_1=22
# SSH_USER_1=scripter
# SSH_KEY_PATH_1=/run/scripter/keys/id_ed25519
# SSH_USE_SUDO_1=1
# SSH_SUDO_WRAPPER_1=/usr/local/sbin/scripter-run
# SSH_LABEL_1=server-1

# Optional strict host-key file inside the container.
# SSH_KNOWN_HOSTS=/run/scripter/keys/known_hosts

# Optional Socket.IO origin. Leave unset unless a reverse proxy requires it.
# SOCKETIO_ORIGIN=https://scripter.example.local
